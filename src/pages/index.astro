---
import Layout from "@/layouts/main.astro"
import { SITE } from "@/site.config"

const paypal = (href: string) => (href === "PAYPAL" ? SITE.paypalUrl : href)
---

<Layout>
  <div class="min-h-svh">
    <!-- Nav -->
    <header class="sticky top-0 z-50 border-b border-zinc-800/60 bg-zinc-950/70 backdrop-blur">
      <div class="mx-auto flex h-16 max-w-6xl items-center justify-between px-6">
        <a href="#" class="flex items-center gap-2 text-sm">
          <span class="hidden font-mono text-zinc-500 sm:inline" aria-hidden="true"
            >{SITE.kaomoji}</span
          >
          <span class="font-semibold text-white">{SITE.brand}</span
          ><span class="text-indigo-400">{SITE.tld}</span>
        </a>
        <nav class="hidden items-center gap-8 text-sm text-zinc-400 md:flex">
          {
            SITE.nav.links.map((link) => (
              <a href={link.href} class="transition hover:text-white">
                {link.label}
              </a>
            ))
          }
        </nav>
        <a
          href={SITE.paypalUrl}
          rel="noopener"
          data-cta="nav"
          class="rounded-full bg-indigo-500 px-4 py-2 text-sm font-semibold text-white transition hover:bg-indigo-400"
        >
          {SITE.nav.cta}
        </a>
      </div>
    </header>

    <!-- Hero -->
    <section class="relative overflow-hidden">
      <div
        class="pointer-events-none absolute inset-0 bg-[radial-gradient(60%_50%_at_50%_0%,rgba(99,102,241,0.15),transparent)]"
      >
      </div>
      <div
        class="pointer-events-none absolute inset-0 bg-[linear-gradient(to_right,rgba(255,255,255,0.04)_1px,transparent_1px),linear-gradient(to_bottom,rgba(255,255,255,0.04)_1px,transparent_1px)] bg-[size:32px_32px] [mask-image:radial-gradient(ellipse_60%_60%_at_50%_0%,black,transparent)]"
      >
      </div>
      <div
        class="relative mx-auto flex max-w-3xl flex-col items-center px-6 pt-24 pb-20 text-center sm:pt-32"
      >
        <span
          class="inline-flex items-center gap-2 rounded-full border border-zinc-800 bg-zinc-900/60 px-3 py-1 text-xs text-zinc-400"
        >
          <span class="size-1.5 animate-pulse rounded-full bg-indigo-400"></span>
          {SITE.hero.pill}
        </span>
        <h1
          class="mt-6 text-4xl font-semibold tracking-tight text-white sm:text-6xl sm:leading-[1.1]"
        >
          {SITE.hero.titleTop}{" "}
          <span
            class="bg-linear-to-r from-indigo-400 via-fuchsia-400 to-indigo-400 bg-clip-text text-transparent"
          >
            {SITE.hero.titleGradient}
          </span>
        </h1>
        <p class="mt-6 max-w-xl text-lg leading-relaxed text-zinc-400">
          {SITE.hero.subtitle}
        </p>
        <div class="mt-8 flex flex-wrap items-center justify-center gap-4">
          <a
            href={SITE.paypalUrl}
            rel="noopener"
            data-cta="hero"
            class="rounded-full bg-indigo-500 px-6 py-3 text-sm font-semibold text-white shadow-lg shadow-indigo-500/25 transition hover:bg-indigo-400"
          >
            {SITE.hero.ctaPrimary}
          </a>
          <a
            href="#pricing"
            class="rounded-full border border-zinc-700 px-6 py-3 text-sm font-medium text-zinc-300 transition hover:border-zinc-500 hover:text-white"
          >
            {SITE.hero.ctaSecondary}
          </a>
        </div>
        <p class="mt-4 text-xs text-zinc-600">{SITE.hero.microcopy}</p>
        <div
          class="mt-12 flex flex-wrap items-center justify-center gap-x-3 gap-y-2 text-sm text-zinc-500"
        >
          {
            SITE.hero.stats.map((stat, i) => (
              <>
                <span>{stat}</span>
                {i < SITE.hero.stats.length - 1 && <span class="text-zinc-700">·</span>}
              </>
            ))
          }
        </div>
      </div>
    </section>

    <!-- Logos -->
    <section class="border-y border-zinc-800/60 py-10">
      <div class="mx-auto max-w-6xl px-6">
        <p class="text-center text-xs tracking-[0.2em] text-zinc-600 uppercase">
          {SITE.logos.label}
        </p>
        <div class="mt-6 grid grid-cols-2 gap-4 sm:grid-cols-5">
          {
            Array.from({ length: SITE.logos.count }).map(() => (
              <div class="flex h-12 items-center justify-center rounded-lg border border-dashed border-zinc-800 text-xs text-zinc-700">
                {SITE.logos.placeholder}
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- Features -->
    <section id="features" class="scroll-mt-24 py-24">
      <div class="mx-auto max-w-6xl px-6">
        <div class="mx-auto max-w-2xl text-center">
          <p class="text-xs font-semibold tracking-[0.2em] text-indigo-400 uppercase">
            {SITE.features.eyebrow}
          </p>
          <h2 class="mt-3 text-3xl font-semibold tracking-tight text-white sm:text-4xl">
            {SITE.features.title}
          </h2>
          <p class="mt-4 text-lg text-zinc-400">{SITE.features.subtitle}</p>
        </div>
        <div class="mt-14 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
          {
            SITE.features.items.map((f) => (
              <div class="group rounded-2xl border border-zinc-800/80 bg-zinc-900/40 p-6 transition hover:border-zinc-700 hover:bg-zinc-900/70">
                <div class="flex size-10 items-center justify-center rounded-lg border border-zinc-800 bg-zinc-900 text-indigo-400 transition group-hover:border-indigo-500/40">
                  <svg
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    class="size-5"
                    aria-hidden="true"
                  >
                    {f.icon.map((d) => (
                      <path d={d} />
                    ))}
                  </svg>
                </div>
                <h3 class="mt-4 font-semibold text-white">{f.title}</h3>
                <p class="mt-2 text-sm leading-relaxed text-zinc-400">{f.text}</p>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- Testimonials -->
    <section id="testimonials" class="scroll-mt-24 border-t border-zinc-800/60 py-24">
      <div class="mx-auto max-w-6xl px-6">
        <div class="mx-auto max-w-2xl text-center">
          <p class="text-xs font-semibold tracking-[0.2em] text-indigo-400 uppercase">
            {SITE.testimonials.eyebrow}
          </p>
          <h2 class="mt-3 text-3xl font-semibold tracking-tight text-white sm:text-4xl">
            {SITE.testimonials.title}
          </h2>
          <p class="mt-4 text-lg text-zinc-400">{SITE.testimonials.subtitle}</p>
        </div>
        <div class="mt-14 grid gap-5 md:grid-cols-3">
          {
            SITE.testimonials.items.map((t) => (
              <figure class="flex flex-col rounded-2xl border border-zinc-800/80 bg-zinc-900/40 p-6">
                <div class="tracking-widest text-amber-400">{t.stars}</div>
                <blockquote class="mt-4 grow text-sm leading-relaxed text-zinc-300">
                  “{t.quote}”
                </blockquote>
                <figcaption class="mt-6 flex items-center gap-3 border-t border-zinc-800/80 pt-4">
                  <span class="flex size-8 items-center justify-center rounded-full bg-zinc-800 text-xs font-semibold text-zinc-400">
                    {t.author.slice(0, 1)}
                  </span>
                  <span class="text-sm">
                    <span class="font-medium text-zinc-200">{t.author}</span>
                    <span class="block text-xs text-zinc-500">{t.role}</span>
                  </span>
                </figcaption>
              </figure>
            ))
          }
        </div>
      </div>
    </section>

    <!-- Pricing -->
    <section id="pricing" class="scroll-mt-24 border-t border-zinc-800/60 py-24">
      <div class="mx-auto max-w-6xl px-6">
        <div class="mx-auto max-w-2xl text-center">
          <p class="text-xs font-semibold tracking-[0.2em] text-indigo-400 uppercase">
            {SITE.pricing.eyebrow}
          </p>
          <h2 class="mt-3 text-3xl font-semibold tracking-tight text-white sm:text-4xl">
            {SITE.pricing.title}
          </h2>
          <p class="mt-4 text-lg text-zinc-400">{SITE.pricing.subtitle}</p>
        </div>
        <div class="mt-14 grid gap-5 md:grid-cols-3">
          {
            SITE.pricing.tiers.map((tier) => (
              <div
                class:list={[
                  "flex flex-col rounded-2xl border p-6",
                  tier.highlight
                    ? "border-indigo-500/50 bg-zinc-900/70 shadow-lg shadow-indigo-500/10"
                    : "border-zinc-800/80 bg-zinc-900/40",
                ]}
              >
                {"badge" in tier && tier.badge && (
                  <span class="mb-4 inline-flex w-fit rounded-full bg-indigo-500/10 px-3 py-1 text-xs font-medium text-indigo-300">
                    {tier.badge}
                  </span>
                )}
                <h3 class="font-semibold text-white">{tier.name}</h3>
                <p class="mt-2">
                  <span class="text-3xl font-semibold tracking-tight text-white">
                    {tier.price}
                  </span>
                  <span class="ml-2 text-xs text-zinc-500">/ {tier.period}</span>
                </p>
                <p class="mt-2 text-sm text-zinc-400">{tier.blurb}</p>
                <ul class="mt-6 grow space-y-3 text-sm">
                  {tier.features.map((f) => (
                    <li class="flex items-start gap-2.5">
                      <span class:list={[f.included ? "text-indigo-400" : "text-zinc-600"]}>
                        {f.included ? "✓" : "✕"}
                      </span>
                      <span class:list={[f.included ? "text-zinc-300" : "text-zinc-600 line-through"]}>
                        {f.label}
                      </span>
                    </li>
                  ))}
                </ul>
                <a
                  href={paypal(tier.href)}
                  rel="noopener"
                  data-cta={`pricing-${tier.name.toLowerCase()}`}
                  class:list={[
                    "mt-8 rounded-full px-4 py-2.5 text-center text-sm font-semibold transition",
                    tier.highlight
                      ? "bg-indigo-500 text-white hover:bg-indigo-400"
                      : "border border-zinc-700 text-zinc-300 hover:border-zinc-500 hover:text-white",
                  ]}
                >
                  {tier.cta}
                </a>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section id="faq" class="scroll-mt-24 border-t border-zinc-800/60 py-24">
      <div class="mx-auto max-w-3xl px-6">
        <div class="text-center">
          <p class="text-xs font-semibold tracking-[0.2em] text-indigo-400 uppercase">
            {SITE.faq.eyebrow}
          </p>
          <h2 class="mt-3 text-3xl font-semibold tracking-tight text-white sm:text-4xl">
            {SITE.faq.title}
          </h2>
        </div>
        <div class="mt-12 space-y-3">
          {
            SITE.faq.items.map((item, i) => (
              <details
                class="group rounded-2xl border border-zinc-800/80 bg-zinc-900/40 px-6 py-4"
                open={i === 0}
              >
                <summary class="flex cursor-pointer items-center justify-between gap-4 text-sm font-medium text-zinc-200 transition hover:text-white">
                  {item.q}
                  <svg
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    class="size-4 shrink-0 text-zinc-500 transition group-open:rotate-180"
                    aria-hidden="true"
                  >
                    <path d="m6 9 6 6 6-6" />
                  </svg>
                </summary>
                <p class="mt-4 text-sm leading-relaxed text-zinc-400">{item.a}</p>
              </details>
            ))
          }
        </div>
      </div>
    </section>

    <!-- Final CTA -->
    <section class="py-24">
      <div class="mx-auto max-w-5xl px-6">
        <div
          class="relative overflow-hidden rounded-3xl border border-zinc-800 bg-linear-to-b from-zinc-900 to-zinc-950 px-6 py-20 text-center"
        >
          <div
            class="pointer-events-none absolute -top-24 left-1/2 h-48 w-[36rem] -translate-x-1/2 rounded-full bg-indigo-500/20 blur-3xl"
          >
          </div>
          <div class="relative">
            <div class="font-mono text-3xl text-zinc-500 sm:text-4xl" aria-hidden="true">
              {SITE.kaomoji}
            </div>
            <h2 class="mt-6 text-3xl font-semibold tracking-tight text-white sm:text-4xl">
              {SITE.finalCta.title}
            </h2>
            <p class="mx-auto mt-4 max-w-md text-lg text-zinc-400">
              {SITE.finalCta.subtitle}
            </p>
            <a
              href={SITE.paypalUrl}
              rel="noopener"
              data-cta="final"
              class="mt-8 inline-block rounded-full bg-indigo-500 px-8 py-3.5 text-sm font-semibold text-white shadow-lg shadow-indigo-500/25 transition hover:bg-indigo-400"
            >
              {SITE.finalCta.button}
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- Footer -->
    <footer class="border-t border-zinc-800/60">
      <div class="mx-auto max-w-6xl px-6 py-14">
        <div class="grid gap-10 md:grid-cols-[2fr_1fr_1fr_1fr]">
          <div>
            <p class="flex items-center gap-2 text-sm">
              <span class="font-mono text-zinc-500" aria-hidden="true"
                >{SITE.kaomoji}</span
              >
              <span class="font-semibold text-white">{SITE.brand}</span
              ><span class="text-indigo-400">{SITE.tld}</span>
            </p>
            <p class="mt-3 max-w-xs text-sm text-zinc-500">{SITE.tagline}</p>
          </div>
          {
            SITE.footer.columns.map((col) => (
              <div>
                <h4 class="text-sm font-semibold text-zinc-200">{col.title}</h4>
                <ul class="mt-4 space-y-2.5 text-sm">
                  {col.links.map((link) => (
                    <li>
                      {"href" in link ? (
                        <a href={link.href} class="text-zinc-500 transition hover:text-zinc-300">
                          {link.label}
                        </a>
                      ) : (
                        <span class="text-zinc-600">{link.labelOnly}</span>
                      )}
                    </li>
                  ))}
                </ul>
              </div>
            ))
          }
        </div>
        <div
          class="mt-12 flex flex-col items-center justify-between gap-4 border-t border-zinc-800/60 pt-8 text-xs text-zinc-600 sm:flex-row"
        >
          <span>{SITE.footer.copyright}</span>
          <span class="flex items-center gap-2">
            <span class="size-1.5 rounded-full bg-amber-500/70"></span>
            {SITE.footer.status}
          </span>
          <span id="timer" data-template={SITE.footer.timerTemplate}>
            {SITE.footer.timerTemplate.replace("{t}", SITE.footer.timerInitial)}
          </span>
        </div>
      </div>
    </footer>
  </div>
</Layout>

<script>
  import { track } from "@vercel/analytics"

  document
    .querySelectorAll<HTMLAnchorElement>("a[data-cta]")
    .forEach((link) => {
      link.addEventListener("click", () => {
        track("paypal_click", { location: link.dataset.cta ?? "unknown" })
      })
    })

  const el = document.getElementById("timer")
  const template = el?.dataset.template

  function format(duration: number): string {
    if (duration < 60) {
      return `${duration} second${duration === 1 ? "" : "s"}`
    }
    const minutes = Math.floor(duration / 60)
    return `${minutes} minute${minutes === 1 ? "" : "s"}`
  }

  if (el && template) {
    const start = Date.now()
    const update = () => {
      const seconds = Math.floor((Date.now() - start) / 1000)
      el.textContent = template.replace("{t}", format(seconds))
    }
    update()
    setInterval(update, 1000)
  }
</script>
